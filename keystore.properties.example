# Local upload-keystore config (DO NOT COMMIT the real file)

# 1. Generate an upload keystore (PKCS12 preferred), e.g.:
#    keytool -genkeypair -v -keystore racktrack-upload.p12 -storetype PKCS12 \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias racktrack
#    Or: pwsh scripts/generate-upload-keystore.ps1
# 2. Copy this file to keystore.properties at the repo root.
# 3. Fill paths/passwords. keystore.properties is gitignored.
# See docs/08-play-store.md for Play Internal + CI secrets.

storeFile=racktrack-upload.p12
storePassword=REPLACE_ME
keyAlias=racktrack
keyPassword=REPLACE_ME
