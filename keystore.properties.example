# Local upload-keystore config (DO NOT COMMIT the real file)

# 1. Generate an upload keystore (example):
#    keytool -genkeypair -v -keystore racktrack-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias racktrack
# 2. Copy this file to keystore.properties at the repo root.
# 3. Fill paths/passwords. keystore.properties is gitignored.

storeFile=racktrack-upload.jks
storePassword=REPLACE_ME
keyAlias=racktrack
keyPassword=REPLACE_ME
